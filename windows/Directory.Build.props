<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!--
      统一版本号的 Windows 侧单一来源（RELEASING.md）：程序集版本 + 设置页显示都从它来，
      vpk 的 packVersion 参数也从它取。发布时与根目录 Resources/Info.plist 的
      CFBundleShortVersionString 一起 bump 到同一个 X.Y.Z（chore(release) 提交）。
      基线 0.2.6 = 当前线上 Windows 版本（stable feed）；首个统一版本从 0.3.0 起。
    -->
    <Version>0.3.2</Version>
  </PropertyGroup>
</Project>
