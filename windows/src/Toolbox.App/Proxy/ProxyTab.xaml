<UserControl x:Class="Toolbox.App.Proxy.ProxyTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14">
            <!-- 引擎 -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="xray 内核" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="EngineStateText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555" />
                <Button x:Name="EngineButton" Content="启动" Click="OnEngineClick" Padding="14,3" Margin="12,0,0,0" />
                <Button Content="测延迟" Click="OnLatencyClick" Padding="14,3" Margin="8,0,0,0" />
                <TextBlock x:Name="LatencyText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#555" />
            </StackPanel>
            <TextBlock x:Name="EngineHint" Foreground="#999" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

            <!-- 节点库 -->
            <TextBlock Text="节点" FontWeight="SemiBold" Margin="0,14,0,0" />
            <ListBox x:Name="NodeList" MinHeight="140" MaxHeight="260"
                     HorizontalContentAlignment="Stretch" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="AddLinkBox" Width="400" VerticalContentAlignment="Center"
                         ToolTip="粘贴 vmess:// / vless:// / trojan:// / ss:// 分享链接" />
                <Button Content="添加" Click="OnAddClick" Padding="14,3" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="双击节点切换为当前节点；勾选 = 加入自动切换候选组（仅 autoSwitch 用）。"
                       Foreground="#999" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

            <!-- 运行时 -->
            <TextBlock Text="运行设置" FontWeight="SemiBold" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="SOCKS 端口" VerticalAlignment="Center" />
                <TextBox x:Name="SocksPortBox" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <TextBlock Text="HTTP 端口" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBox x:Name="HttpPortBox" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <Button Content="应用端口" Click="OnPortsClick" Padding="10,3" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="路由模式" VerticalAlignment="Center" />
                <ComboBox x:Name="RoutingCombo" Width="260" Margin="8,0,0,0" />
                <CheckBox x:Name="AutoSwitchCheck" Content="自动切换（leastPing）"
                          Click="OnAutoSwitchClick" Margin="16,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
            <CheckBox x:Name="SystemProxyCheck" Content="设为系统代理（关 App 时会自动关闭，避免全网断网）"
                      Click="OnSystemProxyClick" Margin="0,8,0,0" />

            <!-- 更新 -->
            <TextBlock Text="内核与规则库" FontWeight="SemiBold" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="检查更新" Click="OnCheckUpdateClick" Padding="12,3" />
                <Button x:Name="CoreUpdateButton" Content="更新内核" Click="OnCoreUpdateClick"
                        Padding="12,3" Margin="8,0,0,0" IsEnabled="False" />
                <Button x:Name="RulesUpdateButton" Content="更新规则库" Click="OnRulesUpdateClick"
                        Padding="12,3" Margin="8,0,0,0" IsEnabled="False" />
                <TextBlock x:Name="VersionText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#555" />
            </StackPanel>

            <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#B00020" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
