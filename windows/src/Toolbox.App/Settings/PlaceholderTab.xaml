<UserControl x:Class="Toolbox.App.Settings.PlaceholderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" VerticalAlignment="Top">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#333" />
        <TextBlock x:Name="BodyText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#777" />
    </StackPanel>
</UserControl>
