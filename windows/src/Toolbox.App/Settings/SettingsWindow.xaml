<Window x:Class="Toolbox.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Toolbox.App.Settings"
        x:ClassModifier="internal"
        Title="Toolbox 设置"
        Width="660" Height="580"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Background="#F7F7F9">
    <TabControl Margin="10">
        <TabItem Header="通用">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <TextBlock Text="快捷键" FontWeight="SemiBold" />
                    <TextBlock Text="点一下开始录制，按下组合键后回车确认，Esc 取消。"
                               Foreground="#777" Margin="0,4,0,10" TextWrapping="Wrap" />

                    <StackPanel x:Name="HotkeyRowsPanel" />
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Separator Margin="0,16" />
                    <CheckBox x:Name="LaunchAtLoginCheck"
                              Content="登录 Windows 时自动启动"
                              Click="OnLaunchAtLoginClick" />
                    <TextBlock x:Name="LaunchAtLoginError" Margin="20,4,0,0"
                               Foreground="#B00020" TextWrapping="Wrap" />

                    <Separator Margin="0,16" />
                    <TextBlock Text="软件更新" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="当前版本" VerticalAlignment="Center" />
                        <TextBlock x:Name="UpdateVersionText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdateClick"
                                Padding="12,3" Margin="16,0,0,0" />
                        <Button Content="手动下载" Click="OnManualDownloadClick"
                                Padding="12,3" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,0" Foreground="#666"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="UpdateInstallRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <Button x:Name="InstallUpdateButton" Content="下载并安装" Click="OnInstallUpdateClick"
                                Padding="14,4" FontWeight="SemiBold" />
                    </StackPanel>
                    <CheckBox x:Name="AutoCheckUpdateCheck" Content="启动时及定期自动检查"
                              Click="OnAutoCheckClick" Margin="0,10,0,0" />
                    <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="检查间隔" VerticalAlignment="Center" />
                        <TextBox x:Name="IntervalBox" Width="48" Margin="8,0,0,0"
                                 LostFocus="OnIntervalChanged" KeyDown="OnIntervalKeyDown" />
                        <TextBlock Text="小时" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#777" />
                    </StackPanel>
                    <CheckBox x:Name="UseProxyCheck" Content="检查/下载走本地代理"
                              Click="OnUseProxyClick" Margin="0,10,0,0" />
                    <StackPanel x:Name="ProxyPortRow" Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="代理端口" VerticalAlignment="Center" />
                        <TextBox x:Name="ProxyPortBox" Width="64" Margin="8,0,0,0"
                                 LostFocus="OnProxyPortChanged" KeyDown="OnProxyPortKeyDown" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="加速镜像" VerticalAlignment="Center" />
                        <TextBox x:Name="MirrorBox" Width="260" Margin="8,0,0,0"
                                 LostFocus="OnMirrorChanged" ToolTip="如 https://ghproxy.net/（留空=不用）。镜像不适用于应用内自动更新，仅供手动下载参考。" />
                    </StackPanel>

                    <Separator Margin="0,16" />
                    <TextBlock Text="文件位置" FontWeight="SemiBold" />
                    <TextBlock x:Name="PathsText" Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="剪贴板">
            <ContentControl x:Name="ClipboardHost" />
        </TabItem>

        <TabItem Header="Hosts 规则">
            <ContentControl x:Name="HostsHost" />
        </TabItem>

        <TabItem Header="截图与贴图">
            <ContentControl x:Name="CaptureHost" />
        </TabItem>

        <TabItem Header="代理">
            <ContentControl x:Name="ProxyHost" />
        </TabItem>

        <TabItem Header="翻译">
            <ContentControl x:Name="TranslationHost" />
        </TabItem>
    </TabControl>
</Window>
