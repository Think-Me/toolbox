<Window x:Class="Toolbox.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Toolbox.App.Settings"
        x:ClassModifier="internal"
        Title="Toolbox 设置"
        Width="660" Height="580"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Background="#F7F7F9">
    <TabControl Margin="10">
        <TabItem Header="通用">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <TextBlock Text="快捷键" FontWeight="SemiBold" />
                    <TextBlock Text="点一下开始录制，按下组合键后回车确认，Esc 取消。"
                               Foreground="#777" Margin="0,4,0,10" TextWrapping="Wrap" />

                    <StackPanel x:Name="HotkeyRowsPanel" />
                    <TextBlock x:Name="HotkeyStatusText" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Separator Margin="0,16" />
                    <CheckBox x:Name="LaunchAtLoginCheck"
                              Content="登录 Windows 时自动启动"
                              Click="OnLaunchAtLoginClick" />
                    <TextBlock x:Name="LaunchAtLoginError" Margin="20,4,0,0"
                               Foreground="#B00020" TextWrapping="Wrap" />

                    <Separator Margin="0,16" />
                    <TextBlock Text="关于" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Toolbox for Windows" VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="#666" />
                    </StackPanel>

                    <Separator Margin="0,16" />
                    <TextBlock Text="文件位置" FontWeight="SemiBold" />
                    <TextBlock x:Name="PathsText" Margin="0,6,0,0" Foreground="#666" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="剪贴板">
            <ContentControl x:Name="ClipboardHost" />
        </TabItem>

        <TabItem Header="Hosts 规则">
            <ContentControl x:Name="HostsHost" />
        </TabItem>

        <TabItem Header="截图与贴图">
            <ContentControl x:Name="CaptureHost" />
        </TabItem>

        <TabItem Header="代理">
            <ContentControl x:Name="ProxyHost" />
        </TabItem>

        <TabItem Header="翻译">
            <ContentControl x:Name="TranslationHost" />
        </TabItem>
    </TabControl>
</Window>
