<UserControl x:Class="Toolbox.App.Settings.CaptureTab"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14">
            <TextBlock Text="选区确认后" FontWeight="SemiBold" />
            <TextBlock Text="什么都不勾 = 划完选区出工具栏，由你决定复制 / 贴图 / 保存。"
                       Foreground="#999" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="CopyCheck" Content="自动复制并关闭（快照模式）" Margin="0,8,0,0" />
            <CheckBox x:Name="PinCheck" Content="自动贴图" Margin="0,6,0,0" />
            <CheckBox x:Name="SaveCheck" Content="自动保存到图片目录" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                <TextBlock Text="目录" VerticalAlignment="Center" Foreground="#777" />
                <TextBox x:Name="SaveDirBox" Width="360" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock Text="留空 = 图片库下的 Toolbox 文件夹。"
                       Foreground="#999" FontSize="11" Margin="20,4,0,0" TextWrapping="Wrap" />

            <TextBlock Text="马赛克" FontWeight="SemiBold" Margin="0,14,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="块大小" VerticalAlignment="Center" />
                <TextBox x:Name="MosaicBlockSizeBox" Width="60" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                <TextBlock Text="像素（DPI 缩放后取整）" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#777" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="保存" Click="OnSaveClick" Padding="20,5" />
                <TextBlock x:Name="SaveStatus" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
