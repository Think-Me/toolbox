<Window x:Class="Toolbox.App.Clipboard.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="剪贴板历史"
        Width="520" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#22000000" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" />
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Padding="8,6"
                     FontSize="14"
                     BorderBrush="#DDD"
                     TextChanged="OnSearchChanged" />

            <ListBox x:Name="ItemsList"
                     Grid.Row="1"
                     Margin="0,8,0,0"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4" Orientation="Horizontal">
                            <Image Source="{Binding Thumbnail}"
                                   MaxHeight="32"
                                   MaxWidth="48"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="400" />
                                <TextBlock Text="{Binding Source}"
                                           FontSize="11"
                                           Foreground="#999" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Margin="2,8,0,0"
                       FontSize="11"
                       Foreground="#888"
                       Text="↑↓ 选择 · Enter 粘贴 · Ctrl+P 置顶 · Del 删除 · Esc 关闭" />
        </Grid>
    </Border>
</Window>
