<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Toolbox.App</RootNamespace>
    <AssemblyName>Toolbox.App</AssemblyName>
    <!-- NOTIFYICONDATAW 的大小随位数变（976 / 956），只锁一种布局 -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Toolbox.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toolbox.Core\Toolbox.Core.csproj" />
    <!-- TTS 朗读：System.Speech（SAPI 封装，仅 Windows） -->
    <PackageReference Include="System.Speech" Version="8.0.*" />
    <!-- 只为让 Elevated 先构建；App 不引用其程序集（通过进程边界调用它） -->
    <ProjectReference Include="..\Toolbox.Elevated\Toolbox.Elevated.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- hosts 提权 helper 要在 App 旁边才能被找到（Debug 用 Elevated 的自包含单文件） -->
  <Target Name="CopyElevatedHelper" AfterTargets="Build;Publish">
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <ElevatedExe Include="..\Toolbox.Elevated\bin\single\Toolbox.Elevated.exe" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <ElevatedExe Include="..\Toolbox.Elevated\bin\$(Configuration)\$(TargetFramework)\Toolbox.Elevated.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- 托盘图标用 LoadImage 从文件加载（WPF 里没有 System.Drawing），所以必须复制到输出目录 -->
    <Content Include="Assets\Toolbox.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
